# Production Environment Variables for Render
NODE_ENV=production
PORT=10000

# These will be automatically set by Render from the database
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Set this to your Vercel frontend URL after deployment
CLIENT_URL=https://your-vercel-app.vercel.app

# This will be auto-generated by Render
# JWT_SECRET=